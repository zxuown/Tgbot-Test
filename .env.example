# ==============================================================================
# Focus Bot — Environment Variables Configuration (.env.example)
# ==============================================================================

# === Execution Mode ===
# Режим работы бота:
# - polling : Telegram bot polling + scheduler (включая FastAPI /health для Web Service)
# - webhook : FastAPI + Telegram webhook endpoint (требуется HTTPS WEBHOOK_URL)
# - worker  : фоновый worker-процесс (только polling + scheduler, без HTTP-сервера)
# - api     : запуск только REST API и MiniApp (без Telegram-бота)
BOT_MODE=polling

# Автоматический запуск Alembic migrations перед стартом (true/false)
AUTO_MIGRATE=true

# === Telegram Bot ===
# Токен бота от @BotFather (ОБЯЗАТЕЛЬНО)
BOT_TOKEN=your-bot-token-here

# Настройки Webhook (только если BOT_MODE=webhook)
WEBHOOK_URL=https://your-domain.onrender.com
WEBHOOK_SECRET=generate-a-random-secret-string
WEBHOOK_PATH=/webhook

# === Database ===
# ВНИМАНИЕ: В production (APP_ENV=production) требуется PostgreSQL!
# Локальная разработка: sqlite+aiosqlite:///focus.db
# PostgreSQL: postgresql+asyncpg://user:password@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///focus.db
DATABASE_ECHO=false

# === Redis ===
# Для FSM-состояний и кэша (при недоступности автоматически переключается на MemoryStorage)
REDIS_URL=redis://localhost:6379/0

# === Application Environment ===
# development | production | test
APP_ENV=development
LOG_LEVEL=INFO
# Формат логов: auto (json в production, console в dev) | json | console
LOG_FORMAT=auto

# Секретный ключ для подписи сессий и токенов (в production сгенерируйте: openssl rand -hex 32)
SECRET_KEY=change-me-to-random-string-min-16-chars

# === AI Provider ===
# mock (для тестов без ключей) | gemini (Google Gemini) | openai (OpenAI / OpenRouter)
# ВНИМАНИЕ: в production при AI_PROVIDER=gemini ключ GEMINI_API_KEY обязателен!
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
AI_MAX_INPUT_CHARS=2000

# OpenAI-совместимый провайдер (если AI_PROVIDER=openai):
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# === Speech-to-Text ===
STT_PROVIDER=mock
STT_API_KEY=
STT_API_BASE_URL=

# === Administration ===
# Telegram ID администраторов через запятую (например: 12345678,87654321)
ADMIN_TELEGRAM_IDS=

# === Mini App & Server ===
MINI_APP_URL=
API_HOST=0.0.0.0
API_PORT=8000
# Порт, инжектируемый облачными провайдерами (Render / Railway):
# PORT=8000

# === Business Limits (Free Tier) ===
FREE_MONTHLY_AI_LIMIT=10
FREE_MAX_TASKS=30
FREE_MAX_HABITS=5

# === Defaults & Localization ===
DEFAULT_TIMEZONE=Europe/Moscow
DEFAULT_LANGUAGE=ru

# === Rate Limits ===
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=5
